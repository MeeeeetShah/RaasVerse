# Super Admin Authentication (Required for /admin portal)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_super_secret_password_here
ADMIN_JWT_SECRET=your_random_jwt_secret_string_here
ADMIN_SALT=your_random_salt_string_here

# Public App Metadata
NEXT_PUBLIC_APP_URL=https://raasverse.com

# Cloudinary Image Upload (Required for portal image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
